# AI English Speaking & Communication Coach - Environment Variables
# BYOK Architecture: No developer AI keys are required to be bundled.
# Users securely configure their own Google Gemini, OpenAI, or Anthropic credentials.

# ==========================================
# Client Environment Variables (Vite - Prefix VITE_)
# Note: NEVER put private API secrets in client variables!
# ==========================================
VITE_APP_NAME="AI English Coach"
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key"

# ==========================================
# Server Environment Variables (Node.js Express)
# Keep these strictly on the server side!
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Master Encryption Secret for AES-256-GCM User BYOK Keys
# Generate a strong 32-byte secret (e.g. `openssl rand -hex 32`)
ENCRYPTION_SECRET="generate_a_secure_32_byte_secret_key_for_aes_256_gcm"

# Supabase Admin / Service Role (Never expose to client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional Server-Level Fallback Providers (Optional - BYOK handles user credentials)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Optional Speech-to-Text & Text-to-Speech Services
# Note: Web Speech API and Web SpeechSynthesis run client-side with 0 external API cost
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
