# AI English Speaking & Communication Coach - Environment Variables

# ==========================================
# Client Environment Variables (Vite - Prefix VITE_)
# Note: NEVER put private API secrets in client variables!
# ==========================================
VITE_APP_NAME="AI English Coach"
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key"

# ==========================================
# Server Environment Variables (Node.js Express)
# Keep these strictly on the server side!
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Supabase Admin / Service Role (Never expose to client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI LLM Provider Configuration
LLM_PROVIDER="openai" # openai | anthropic | gemini
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIzaSy..."

# Speech-to-Text (STT) Provider
STT_PROVIDER="whisper" # whisper | browser
OPENAI_WHISPER_KEY="sk-..."

# Text-to-Speech (TTS) Provider
TTS_PROVIDER="elevenlabs" # elevenlabs | openai | browser
ELEVENLABS_API_KEY="your-elevenlabs-key"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM" # Rachel / natural supportive voice

# Rate Limiting & Quotas
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
